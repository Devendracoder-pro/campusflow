{
  "name": "campusflow",
  "version": "1.0.0",
  "private": true,
  "description": "Dependency-free local college management prototype",
  "scripts": {
    "start": "node server.js",
    "prestart": "npm run build",
    "build": "vite build",
    "dev": "vite --host 0.0.0.0",
    "migrate": "node db/migrate.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.test.js",
    "check": "node --check core.js && node --check app.js && node --check server.js"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "lucide-react": "^1.43.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "vite": "^8.2.2"
  }
}
